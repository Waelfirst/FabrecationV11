<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Confirm Project Wizard -->
    <record id="view_project_confirm_wizard_form" model="ir.ui.view">
        <field name="name">project.confirm.wizard.form</field>
        <field name="model">project.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Project">
                <sheet>
                    <div class="alert alert-success" role="alert" invisible="not validation_passed">
                        <strong>✓ Project Ready for Confirmation</strong>
                        <p><field name="validation_message"/></p>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="validation_passed">
                        <strong>⚠️ Validation Issues Found</strong>
                        <p><field name="validation_message"/></p>
                    </div>

                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="validation_passed" invisible="1"/>
                        <field name="has_products" invisible="1"/>
                        <field name="has_evaluation" invisible="1"/>
                        <field name="has_operations" invisible="1"/>
                        <field name="has_components" invisible="1"/>
                    </group>

                    <group string="Confirmation Options">
                        <field name="confirm_evaluation"/>
                        <field name="create_operations" invisible="has_operations"/>
                    </group>

                    <group>
                        <field name="notes" placeholder="Confirmation notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_project" string="Confirm Project"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_confirm_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Project</field>
        <field name="res_model">project.confirm.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_steel_project"/>
    </record>

    <!-- Create Sales Order Wizard -->
    <record id="view_project_create_sales_order_form" model="ir.ui.view">
        <field name="name">project.create.sales.order.form</field>
        <field name="model">project.create.sales.order</field>
        <field name="arch" type="xml">
            <form string="Create Sales Order">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="pricelist_id"/>
                            <field name="payment_term_id"/>
                            <field name="validity_date"/>
                        </group>
                    </group>

                    <group string="📋 Configuration">
                        <group>
                            <field name="include_evaluation"/>
                            <field name="evaluation_id" invisible="not include_evaluation"/>
                            <field name="include_components"/>
                        </group>
                        <group>
                            <field name="check_material_availability"/>
                            <field name="auto_create_rfq" invisible="not check_material_availability"/>
                            <field name="reserve_materials"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📦 Order Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom" decoration-danger="not is_available">
                                    <field name="include" widget="boolean_toggle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                    <field name="source" widget="badge"/>
                                    <field name="available_qty"/>
                                    <field name="shortage_qty"/>
                                    <field name="is_available" invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="📝 Notes" name="notes">
                            <field name="notes" placeholder="Additional notes for sales order..."/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_sales_order" string="Create Sales Order"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_create_sales_order" model="ir.actions.act_window">
        <field name="name">Create Sales Order</field>
        <field name="res_model">project.create.sales.order</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_steel_project"/>
    </record>

    <!-- Create Work Order Wizard -->
    <record id="view_project_create_work_order_form" model="ir.ui.view">
        <field name="name">project.create.work.order.form</field>
        <field name="model">project.create.work.order</field>
        <field name="arch" type="xml">
            <form string="Create Work Orders">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="name"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="date_planned_start"/>
                            <field name="date_planned_finished"/>
                            <field name="workcenter_id"/>
                        </group>
                    </group>

                    <group string="🎯 Operations">
                        <field name="create_from_operations"/>
                        <field name="operation_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>

                    <group string="📊 Matrix Tracking">
                        <field name="create_matrix"/>
                        <field name="matrix_auto_load" invisible="not create_matrix"/>
                    </group>

                    <group>
                        <field name="notes" placeholder="Work order notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_work_order" string="Create Work Orders"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_create_work_order" model="ir.actions.act_window">
        <field name="name">Create Work Orders</field>
        <field name="res_model">project.create.work.order</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_steel_project"/>
    </record>

</odoo>