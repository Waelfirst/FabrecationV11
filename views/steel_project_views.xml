<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project Tree View -->
    <record id="view_steel_project_tree" model="ir.ui.view">
        <field name="name">steel.project.tree</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <tree string="Steel Projects" decoration-info="state == 'draft'"
                  decoration-success="state == 'done'" decoration-primary="state == 'in_progress'">
                <field name="name"/>
                <field name="project_code"/>
                <field name="partner_id"/>
                <field name="project_manager_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_estimated_cost"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Project Form View -->
    <record id="view_steel_project_form" model="ir.ui.view">
        <field name="name">steel.project.form</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <form string="Steel Project">
                <header>
                    <button name="%(steel_structure_project.action_project_confirm_wizard)d"
                            string="✓ Confirm Project"
                            type="action"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="%(steel_structure_project.action_project_create_sales_order)d"
                            string="📝 Create Sales Order"
                            type="action"
                            class="btn-success"
                            invisible="state not in ['confirmed', 'in_progress']"/>

                    <button name="%(steel_structure_project.action_project_create_work_order)d"
                            string="🏭 Create Work Orders"
                            type="action"
                            class="btn-info"
                            invisible="state not in ['confirmed', 'in_progress']"/>

                    <button name="action_set_to_draft" string="Set to Draft" type="object"
                            class="btn-secondary" invisible="state == 'draft'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_operations" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="operation_count" widget="statinfo" string="Operations"/>
                        </button>
                        <button name="action_view_evaluations" type="object"
                                class="oe_stat_button" icon="fa-calculator">
                            <field name="evaluation_count" widget="statinfo" string="Evaluations"/>
                        </button>
                        <button name="%(steel_structure_project.action_steel_operation_matrix)d"
                                type="action"
                                class="oe_stat_button" icon="fa-table"
                                context="{'default_project_ids': [(6, 0, [id])]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Operation</span>
                                <span class="o_stat_text">Matrix</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name..."/>
                        </h1>
                        <h3>
                            <field name="project_code" placeholder="Project Code..."/>
                        </h3>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="project_manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="project_type"/>
                        </group>
                    </group>

                    <group string="Financial Information">
                        <group>
                            <field name="total_estimated_cost" widget="monetary"/>
                            <field name="total_actual_cost" widget="monetary"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost_variance" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📦 Products" name="products">
                            <field name="product_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="component_id"/>
                                    <field name="product_quantity"/>
                                    <field name="uom_id"/>
                                    <field name="estimated_cost"/>
                                </tree>
                            </field>
                        </page>

                        <page string="⚙️ Operations" name="operations">
                            <field name="operation_ids">
                                <tree>
                                    <field name="display_name"/>
                                    <field name="product_id"/>
                                    <field name="operation_type_id"/>
                                    <field name="operation_quantity"/>
                                    <field name="start_date"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>

                        <page string="📋 Evaluations" name="evaluations">
                            <field name="evaluation_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="evaluation_date"/>
                                    <field name="total_parts"/>
                                    <field name="total_estimated_cost"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>

                        <page string="📝 Description" name="description">
                            <field name="description" placeholder="Project description and notes..."/>
                        </page>

                        <page string="📎 Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Project Search View -->
    <record id="view_steel_project_search" model="ir.ui.view">
        <field name="name">steel.project.search</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <search string="Search Projects">
                <field name="name" string="Project"
                       filter_domain="['|', ('name', 'ilike', self), ('project_code', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="project_manager_id"/>
                <field name="state"/>

                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>

                <separator/>
                <filter string="My Projects" name="my_projects"
                        domain="[('project_manager_id', '=', uid)]"/>

                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('start_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('start_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Project Manager" name="group_manager" context="{'group_by': 'project_manager_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'start_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Project Kanban View -->
    <record id="view_steel_project_kanban" model="ir.ui.view">
        <field name="name">steel.project.kanban</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="total_estimated_cost"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge badge-pill">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="total_estimated_cost" widget="monetary"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="project_manager_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Project Calendar View -->
    <record id="view_steel_project_calendar" model="ir.ui.view">
        <field name="name">steel.project.calendar</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <calendar string="Projects" date_start="start_date" date_stop="end_date"
                      color="state" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Project Pivot View -->
    <record id="view_steel_project_pivot" model="ir.ui.view">
        <field name="name">steel.project.pivot</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <pivot string="Projects Analysis">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_estimated_cost" type="measure"/>
                <field name="total_actual_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Project Graph View -->
    <record id="view_steel_project_graph" model="ir.ui.view">
        <field name="name">steel.project.graph</field>
        <field name="model">steel.project</field>
        <field name="arch" type="xml">
            <graph string="Projects Analysis" type="bar">
                <field name="state"/>
                <field name="total_estimated_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Project Action -->
    <record id="action_steel_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">steel.project</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_my_projects': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Steel Structure Project
            </p>
            <p>
                Track and manage steel structure projects with integrated evaluation,
                operations, and cost tracking.
            </p>
        </field>
    </record>

</odoo>