<?xml version="1.0" encoding="utf-8"?>
<!--
    views/steel_project_components_views.xml - COMPLETE FILE
    Copy this entire file and replace your existing steel_project_components_views.xml
-->
<odoo>
    <!-- ========================================== -->
    <!-- STEEL PROJECT COMPONENTS FORM VIEW        -->
    <!-- Enhanced with Multi-Select & Duplicate    -->
    <!-- ========================================== -->
    <record id="view_steel_project_components_form" model="ir.ui.view">
        <field name="name">steel.project.components.form</field>
        <field name="model">steel.project.components</field>
        <field name="arch" type="xml">
            <form string="Project Components">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start_production" string="Start Production" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="oe_highlight" invisible="state != 'in_production'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_production,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_parts" icon="fa-cubes">
                            <field string="Parts" name="total_parts" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_stages" icon="fa-tasks">
                            <field string="Stages" name="total_stages" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="product_id" domain="[('project_id', '=', project_id)]"/>
                        </group>
                        <group>
                            <label for="total_parts"/>
                            <div>
                                <field name="total_parts" class="oe_inline"/> parts
                                (<field name="total_parts_quantity" class="oe_inline"/> total qty)
                            </div>
                            <field name="total_parts_cost" widget="monetary"/>
                            <field name="total_stages_cost" widget="monetary"/>
                            <field name="total_component_cost" widget="monetary"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ============================================ -->
                        <!-- PRODUCT PARTS TAB                           -->
                        <!-- ============================================ -->
                        <page string="Product Parts" name="parts">
                            <div class="alert alert-success mb-3" role="alert" style="border-left: 5px solid #28a745;">
                                <div class="row align-items-center">
                                    <div class="col-md-9">
                                        <h5 class="mb-2">
                                            <i class="fa fa-magic"/> Smart Import with Auto-Creation
                                        </h5>
                                        <div class="d-flex align-items-center">
                                            <field name="auto_create_missing_records" widget="boolean_toggle" class="me-3"/>
                                            <div>
                                                <strong>Automatically create missing materials</strong>
                                                <div class="text-muted small mt-1">
                                                    When enabled, the system will automatically create any materials (products)
                                                    that are not found in the database during Excel import.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <span class="badge bg-success fs-6 p-2" invisible="not auto_create_missing_records">
                                            <i class="fa fa-check-circle"/> Auto-Create ON
                                        </span>
                                        <span class="badge bg-warning text-dark fs-6 p-2" invisible="auto_create_missing_records">
                                            <i class="fa fa-exclamation-triangle"/> Manual Only
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <group>
                                <group string="Import Parts from Excel">
                                    <field name="import_file" filename="import_filename"/>
                                    <field name="import_filename" invisible="1"/>
                                </group>
                                <group>
                                    <button name="action_download_parts_template"
                                            string="📥 Download Template"
                                            type="object"
                                            icon="fa-download"
                                            class="oe_highlight"/>
                                    <button name="action_import_parts_from_excel"
                                            string="📤 Import from Excel"
                                            type="object"
                                            icon="fa-upload"
                                            class="btn-success"
                                            invisible="not import_file"/>
                                </group>
                            </group>

                            <div class="alert alert-info" role="alert">
                                <strong>Total Parts: <field name="total_parts" readonly="1"/></strong>
                                | Total Quantity: <field name="total_parts_quantity" readonly="1"/>
                                | Total Cost: <field name="total_parts_cost" widget="monetary" readonly="1"/>
                            </div>

                            <field name="part_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="part_name"/>
                                    <field name="part_number"/>
                                    <field name="material_id"/>
                                    <field name="quantity" string="Qty per Unit"/>
                                    <field name="product_quantity" readonly="1"/>
                                    <field name="total_quantity" readonly="1" sum="Total Qty"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost" readonly="1"/>
                                    <field name="total_cost" sum="Total Cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- ============================================ -->
                        <!-- PRODUCTION STAGES TAB - ENHANCED            -->
                        <!-- With Multi-Select Workers & Machines        -->
                        <!-- ============================================ -->
                        <page string="Production Stages (MRP Operations)" name="stages">
                            <div class="alert alert-primary mb-3" role="alert" style="border-left: 5px solid #0d6efd;">
                                <h5 class="mb-2">
                                    <i class="fa fa-info-circle"/> Production Stages - Multiple Operations per Part
                                </h5>
                                <p class="mb-1">
                                    <strong>Create multiple stages for each part:</strong>
                                </p>
                                <ul class="mb-0">
                                    <li><strong>Part:</strong> Column-A → <strong>Stages:</strong> Cut-1, Weld-1, Paint-1</li>
                                    <li><strong>Part:</strong> Beam-B → <strong>Stages:</strong> Cut-2, Weld-2, Finish-1</li>
                                    <li>Each stage = One MRP Operation with auto-filled data</li>
                                    <li><strong>⚠️ No Duplicates:</strong> Same operation cannot be added twice for one part</li>
                                    <li><strong>👥 Multiple Workers:</strong> Assign many workers per stage</li>
                                    <li><strong>🔧 Multiple Machines:</strong> Assign many machines per stage</li>
                                </ul>
                            </div>

                            <div class="alert alert-warning mb-3" role="alert" style="border-left: 4px solid #ff9800;">
                                <h5 class="alert-heading mb-3">
                                    <i class="fa fa-plus-circle"/> How to Add Multiple Stages for One Part
                                </h5>
                                <p><strong>Steps to create a production flow:</strong></p>
                                <ol class="mb-2">
                                    <li>Click <strong>"Add a line"</strong> below</li>
                                    <li>Select the <strong>Part</strong> (e.g., Column-A)</li>
                                    <li>Select the <strong>MRP Operation</strong> (e.g., Cut-1)</li>
                                    <li>Select <strong>Workers</strong> (can select multiple)</li>
                                    <li>Select <strong>Machines</strong> (can select multiple)</li>
                                    <li>Data auto-fills (Workcenter, Time, Cost)</li>
                                    <li>Click <strong>"Add a line"</strong> again for the same part</li>
                                    <li>Select <strong>same Part</strong> (Column-A) + different <strong>Operation</strong> (Weld-1)</li>
                                    <li>Repeat for all operations needed for that part</li>
                                </ol>
                                <p class="mb-0 text-success">
                                    <i class="fa fa-check-circle"/> <strong>Result:</strong> One part with multiple sequential stages!
                                </p>
                            </div>

                            <!-- IMPORT STAGES FROM EXCEL -->
                            <group>
                                <group string="Import Stages from Excel">
                                    <field name="import_stage_file" filename="import_stage_filename"/>
                                    <field name="import_stage_filename" invisible="1"/>
                                </group>
                                <group>
                                    <button name="action_download_stages_template"
                                            string="📥 Download Template"
                                            type="object"
                                            icon="fa-download"
                                            class="oe_highlight"/>
                                    <button name="action_import_stages_from_excel"
                                            string="📤 Import from Excel"
                                            type="object"
                                            icon="fa-upload"
                                            class="btn-success"
                                            invisible="not import_stage_file"/>
                                </group>
                            </group>

                            <div class="alert alert-info" role="alert">
                                <div class="row">
                                    <div class="col-md-8">
                                        <strong>Total Stages: <field name="total_stages" readonly="1"/></strong>
                                        | Total Labor Cost: <field name="total_stages_cost" widget="monetary" readonly="1"/>
                                    </div>
                                </div>
                            </div>

                            <!-- ENHANCED STAGES TREE VIEW WITH MULTI-SELECT -->
                            <field name="stage_ids">
                                <tree editable="bottom" default_order="part_name,sequence"
                                      decoration-info="quality_check_required == True">

                                    <field name="sequence" widget="handle"/>

                                    <!-- Part Selection -->
                                    <field name="part_id"
                                           required="1"
                                           domain="[('component_id', '=', parent.id)]"
                                           options="{'no_create': True}"/>
                                    <field name="part_name" readonly="1" optional="show"/>
                                    <field name="part_number" readonly="1" optional="hide"/>

                                    <!-- MRP Operation Selection -->
                                    <field name="operation_id"
                                           string="MRP Operation"
                                           required="1"
                                           placeholder="Select: Cut-1, Weld-2..."
                                           options="{'no_create': True}"/>

                                    <!-- Auto-filled fields -->
                                    <field name="stage_name" readonly="1" string="Stage Name"/>
                                    <field name="workcenter_id" readonly="1"/>

                                    <!-- MULTIPLE WORKERS - Many2many Tags -->
                                    <field name="worker_ids"
                                           widget="many2many_tags"
                                           placeholder="Select workers..."
                                           options="{'color_field': 'color', 'no_create': True}"/>

                                    <!-- Worker Count Badge -->
                                    <field name="worker_count"
                                           string="👥"
                                           optional="show"
                                           widget="badge"
                                           decoration-success="worker_count > 0"
                                           decoration-warning="worker_count == 0"/>

                                    <!-- MULTIPLE MACHINES - Many2many Tags -->
                                    <field name="machine_ids"
                                           widget="many2many_tags"
                                           placeholder="Select machines..."
                                           options="{'color_field': 'color', 'no_create': True}"/>

                                    <!-- Machine Count Badge -->
                                    <field name="machine_count"
                                           string="🔧"
                                           optional="show"
                                           widget="badge"
                                           decoration-success="machine_count > 0"
                                           decoration-warning="machine_count == 0"/>

                                    <!-- Time and Cost -->
                                    <field name="required_time" string="Time (hrs)"/>
                                    <field name="hourly_rate" string="Rate ($/hr)"/>
                                    <field name="estimated_labor_cost" sum="Total Cost"/>

                                    <!-- Quality Check -->
                                    <field name="quality_check_required"
                                           widget="boolean_toggle"
                                           optional="show"/>

                                    <!-- Hidden fields -->
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="component_id" column_invisible="1"/>
                                </tree>

                                <!-- ENHANCED FORM VIEW -->
                                <form string="Production Stage">
                                    <sheet>
                                        <field name="component_id" invisible="1"/>

                                        <!-- Duplicate Warning Banner -->
                                        <div class="alert alert-warning" role="alert"
                                             style="margin-bottom: 20px;"
                                             invisible="not operation_id or not part_id">
                                            <h4>
                                                <i class="fa fa-exclamation-triangle"/>
                                                <strong>Duplicate Prevention Active</strong>
                                            </h4>
                                            <p>
                                                Each operation can only be added <strong>ONCE</strong> per part.<br/>
                                                If you try to create a duplicate, the system will prevent it.
                                            </p>
                                        </div>

                                        <!-- Smart Buttons -->
                                        <div class="oe_button_box" name="button_box">
                                            <button class="oe_stat_button" icon="fa-industry">
                                                <div class="o_field_widget o_stat_info">
                                                    <span class="o_stat_value">
                                                        <field name="workcenter_id" readonly="1"/>
                                                    </span>
                                                    <span class="o_stat_text">Workcenter</span>
                                                </div>
                                            </button>
                                            <button class="oe_stat_button" icon="fa-users">
                                                <field string="Workers" name="worker_count" widget="statinfo"/>
                                            </button>
                                            <button class="oe_stat_button" icon="fa-wrench">
                                                <field string="Machines" name="machine_count" widget="statinfo"/>
                                            </button>
                                        </div>

                                        <div class="oe_title">
                                            <label for="part_id" class="oe_edit_only"/>
                                            <h2>
                                                <field name="part_id"
                                                       domain="[('component_id', '=', component_id)]"
                                                       options="{'no_create': True}"
                                                       placeholder="Select Part..."/>
                                            </h2>
                                            <h1>
                                                <field name="stage_name" readonly="1" placeholder="Select MRP Operation..."/>
                                            </h1>
                                        </div>

                                        <!-- Basic Information -->
                                        <group>
                                            <group string="Stage Selection">
                                                <field name="part_name" readonly="1"/>
                                                <field name="part_number" readonly="1"/>

                                                <!-- PRIMARY FIELD: MRP Operation Selection -->
                                                <field name="operation_id"
                                                       string="MRP Operation"
                                                       required="1"
                                                       options="{'no_create': True}"
                                                       placeholder="Select: Cut-1, Weld-2, Paint-1..."/>

                                                <field name="stage_code" readonly="1" string="Stage Code"/>
                                                <field name="sequence"/>
                                            </group>
                                            <group string="Auto-Filled from Operation">
                                                <field name="workcenter_id" readonly="1"/>
                                                <label for="required_time"/>
                                                <div class="d-flex">
                                                    <field name="required_time" class="oe_inline"/>
                                                    <span class="text-muted ms-2">hours</span>
                                                </div>
                                                <label for="hourly_rate"/>
                                                <div class="d-flex">
                                                    <field name="hourly_rate" class="oe_inline"/>
                                                    <span class="text-muted ms-2">$/hr</span>
                                                </div>
                                                <field name="estimated_labor_cost" widget="monetary"/>
                                                <field name="currency_id" invisible="1"/>
                                            </group>
                                        </group>

                                        <!-- Info Box -->
                                        <div class="alert alert-success" role="alert">
                                            <strong>💡 Production Flow for this Part:</strong><br/>
                                            This is <strong>one stage</strong> in the production sequence for
                                            <strong><field name="part_name" readonly="1"/></strong>.<br/>
                                            Add more stages by creating additional lines with the same part but different MRP Operations.
                                        </div>

                                        <!-- Notebook Tabs -->
                                        <notebook>
                                            <!-- Workers and Machines Tab - ENHANCED -->
                                            <page string="👷 Workers &amp; 🔧 Machines" name="resources">
                                                <group>
                                                    <group string="👥 Assign Multiple Workers">
                                                        <field name="worker_ids"
                                                               widget="many2many_tags"
                                                               placeholder="Select workers for this stage..."
                                                               options="{'no_create': True, 'color_field': 'color'}"
                                                               nolabel="1"/>
                                                        <div class="text-muted mt-2">
                                                            💡 <strong>Tip:</strong> You can assign multiple workers.<br/>
                                                            Click to add/remove workers from the dropdown.
                                                        </div>
                                                    </group>
                                                    <group string="🔧 Assign Multiple Machines">
                                                        <field name="machine_ids"
                                                               widget="many2many_tags"
                                                               placeholder="Select machines for this stage..."
                                                               options="{'no_create': True, 'color_field': 'color'}"
                                                               nolabel="1"/>
                                                        <div class="text-muted mt-2">
                                                            💡 <strong>Tip:</strong> You can assign multiple machines.<br/>
                                                            Click to add/remove equipment from the dropdown.
                                                        </div>
                                                    </group>
                                                </group>

                                                <!-- Worker Details Table -->
                                                <group string="📋 Assigned Workers Details" invisible="not worker_ids">
                                                    <field name="worker_ids" nolabel="1" mode="tree">
                                                        <tree create="false" edit="false" delete="false">
                                                            <field name="name"/>
                                                            <field name="job_title"/>
                                                            <field name="department_id"/>
                                                        </tree>
                                                    </field>
                                                </group>

                                                <!-- Machine Details Table -->
                                                <group string="📋 Assigned Machines Details" invisible="not machine_ids">
                                                    <field name="machine_ids" nolabel="1" mode="tree">
                                                        <tree create="false" edit="false" delete="false">
                                                            <field name="name"/>
                                                            <field name="equipment_assign_to"/>
                                                            <field name="category_id"/>
                                                        </tree>
                                                    </field>
                                                </group>
                                            </page>

                                            <!-- MRP Operation Details -->
                                            <page string="⚙️ Operation Details" name="operation_details">
                                                <group>
                                                    <group string="Operation Information">
                                                        <field name="operation_id" readonly="1"/>
                                                        <field name="workcenter_id" readonly="1"/>
                                                        <field name="description" readonly="1" string="Operation Notes"/>
                                                    </group>
                                                </group>
                                            </page>

                                            <!-- Quality Control Tab -->
                                            <page string="✅ Quality Control" name="quality">
                                                <group>
                                                    <field name="quality_check_required"/>
                                                    <field name="quality_criteria"
                                                           placeholder="Define quality check criteria for this stage..."
                                                           invisible="not quality_check_required"/>
                                                </group>
                                            </page>

                                            <!-- Additional Instructions Tab -->
                                            <page string="📝 Instructions" name="instructions">
                                                <field name="description" placeholder="Additional instructions for this stage..."/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <!-- ============================================ -->
                        <!-- COST SUMMARY TAB                            -->
                        <!-- ============================================ -->
                        <page string="Cost Summary" name="summary">
                            <group>
                                <group string="Material Costs">
                                    <label for="total_parts"/>
                                    <div>
                                        <field name="total_parts" class="oe_inline"/> parts
                                        (<field name="total_parts_quantity" class="oe_inline"/> total quantity)
                                    </div>
                                    <field name="total_parts_cost" widget="monetary"/>
                                </group>
                                <group string="Labor Costs">
                                    <label for="total_stages"/>
                                    <div>
                                        <field name="total_stages" class="oe_inline"/> stages
                                    </div>
                                    <field name="total_stages_cost" widget="monetary"/>
                                </group>
                            </group>
                            <group>
                                <group string="Total Component Cost">
                                    <field name="total_component_cost" widget="monetary"
                                           class="oe_subtotal_footer_separator"
                                           style="font-size: 1.2em; font-weight: bold;"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- STEEL PROJECT COMPONENTS TREE VIEW        -->
    <!-- ========================================== -->
    <record id="view_steel_project_components_tree" model="ir.ui.view">
        <field name="name">steel.project.components.tree</field>
        <field name="model">steel.project.components</field>
        <field name="arch" type="xml">
            <tree string="Project Components"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-primary="state == 'in_production'"
                  decoration-success="state == 'done'">
                <field name="display_name"/>
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="total_parts" sum="Total Parts"/>
                <field name="total_parts_quantity" sum="Total Qty"/>
                <field name="total_stages" sum="Total Stages"/>
                <field name="total_parts_cost" sum="Parts Cost"/>
                <field name="total_stages_cost" sum="Labor Cost"/>
                <field name="total_component_cost" sum="Total Cost"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'in_production'"
                       decoration-success="state == 'done'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- STEEL PROJECT COMPONENTS KANBAN VIEW      -->
    <!-- ========================================== -->
    <record id="view_steel_project_components_kanban" model="ir.ui.view">
        <field name="name">steel.project.components.kanban</field>
        <field name="model">steel.project.components</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="display_name"/>
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="total_parts"/>
                <field name="total_stages"/>
                <field name="total_component_cost"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="display_name"/>
                                    </strong>
                                </div>
                                <span class="badge float-end"
                                      t-attf-class="badge-{{state == 'done' ? 'success' : state == 'in_production' ? 'primary' : state == 'confirmed' ? 'warning' : 'secondary'}}">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span class="fa fa-cubes"/> <field name="total_parts"/> Parts
                                        (<field name="total_parts_quantity"/> qty)
                                    </div>
                                    <div class="col-6">
                                        <span class="fa fa-tasks"/> <field name="total_stages"/> Stages
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <strong>Total Cost: </strong>
                                        <field name="total_component_cost" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- STEEL PROJECT COMPONENTS SEARCH VIEW      -->
    <!-- ========================================== -->
    <record id="view_steel_project_components_search" model="ir.ui.view">
        <field name="name">steel.project.components.search</field>
        <field name="model">steel.project.components</field>
        <field name="arch" type="xml">
            <search string="Search Components">
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="display_name"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Production" name="in_production" domain="[('state', '=', 'in_production')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Has Parts" name="has_parts" domain="[('total_parts', '>', 0)]"/>
                <filter string="Has Stages" name="has_stages" domain="[('total_stages', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- STEEL PROJECT COMPONENTS ACTION           -->
    <!-- ========================================== -->
    <record id="action_steel_project_components" model="ir.actions.act_window">
        <field name="name">Project Components</field>
        <field name="res_model">steel.project.components</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define components for your steel structure products
            </p>
            <p>
                Components contain parts (materials) and production stages.<br/>
                <strong>✨ Production Stages Features:</strong><br/>
                • Create multiple stages for each part (e.g., Column-A: Cut-1, Weld-1, Paint-1)<br/>
                • Each stage = One MRP Operation with auto-filled Workcenter, Time, and Cost<br/>
                • <strong>👥 Assign multiple workers per stage</strong><br/>
                • <strong>🔧 Assign multiple machines per stage</strong><br/>
                • <strong>🚫 Duplicate prevention - one operation per part only</strong><br/>
                • Import stages from Excel with workers and machines<br/>
                • System prevents duplicate operations for the same part<br/>
                • Track actual vs. standard performance for each stage
            </p>
        </field>
    </record>

</odoo>