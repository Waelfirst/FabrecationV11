<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Project Sequence -->
        <record id="seq_steel_project" model="ir.sequence">
            <field name="name">Steel Project</field>
            <field name="code">steel.project</field>
            <field name="prefix">PROJ/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Evaluation Sequence -->
        <record id="seq_steel_evaluation" model="ir.sequence">
            <field name="name">Steel Evaluation</field>
            <field name="code">steel.project.evaluation</field>
            <field name="prefix">EVAL/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Operation Sequence -->
        <record id="seq_steel_operation" model="ir.sequence">
            <field name="name">Steel Operation</field>
            <field name="code">steel.project.operation</field>
            <field name="prefix">OP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Component Sequence -->
        <record id="seq_steel_component" model="ir.sequence">
            <field name="name">Steel Component</field>
            <field name="code">steel.product.component</field>
            <field name="prefix">COMP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>